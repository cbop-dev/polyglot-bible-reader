": [{"word": "At", "trailer": " ", "id": 0}, {"word": "their", "trailer": " ", "id": 0}, {"word": "presence", "trailer": " ", "id": 0}, {"word": "the", "trailer": " ", "id": 0}, {"word": "peoples", "trailer": " ", "id": 0}, {"word": "are", "trailer": " ", "id": 0}, {"word": "in", "trailer": " ", "id": 0}, {"word": "anguish", "trailer": ". ", "id": 0}], "notes": [], "section": "Joel 2:6"}, "7": {"text": "They run like mighty men.", "raw_text": "They run like mighty men.", "words": [{"word": "They", "trailer": " ", "id": 0}, {"word": "run", "trailer": " ", "id": 0}, {"word": "like", "trailer": " ", "id": 0}, {"word": "mighty", "trailer": " ", "id": 0}, {"word": "men", "trailer": ". ", "id": 0}], "notes": [], "section": "Joel 2:7"}, "8": {"text": "One doesn’t jostle another.", "raw_text": "One doesn’t jostle another.", "words": [{"word": "One", "trailer": " ", "id": 0}, {"word": "doesn", "trailer": "’ ", "id": 0}, {"word": "t", "trailer": " ", "id": 0}, {"word": "jostle", "trailer": " ", "id": 0}, {"word": "another", "trailer": ". ", "id": 0}], "notes": [], "section": "Joel 2:8"}, "9": {"text": "They rush on the city.", "raw_text": "They rush on the city.", "words": [{"word": "They", "trailer": " ", "id": 0}, {"word": "rush", "trailer": " ", "id": 0}, {"word": "on", "trailer": " ", "id": 0}, {"word": "the", "trailer": " ", "id": 0}, {"word": "city", "trailer": ". ", "id": 0}], "notes": [], "section": "Joel 2:9"}, "10": {"text": "The earth quakes before them.", "raw_text": "The earth quakes before them.", "words": [{"word": "The", "trailer": " ", "id": 0}, {"word": "earth", "trailer": " ", "id": 0}, {"word": "quakes", "trailer": " ", "id": 0}, {"word": "before", "trailer": " ", "id": 0}, {"word": "them", "trailer": ". ", "id": 0}], "notes": [], "section": "Joel 2:10"}, "11": {"text": "The LORD thunders his voice before his army,", "raw_text": "The LORD thunders his voice before his army,", "words": [{"word": "The", "trailer": " ", "id": 0}, {"word": "LORD", "trailer": "