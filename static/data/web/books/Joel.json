{"book": "Joel", "abbrev": "Joel", "chapters": {"1": {"1": {"text": "The LORD’s word that came to Joel, the son of Pethuel.", "raw_text": "The LORD’s word that came to Joel, the son of Pethuel.", "words": [{"word": "The", "trailer": " ", "id": 0}, {"word": "LORD", "trailer": "’ ", "id": 0}, {"word": "s", "trailer": " ", "id": 0}, {"word": "word", "trailer": " ", "id": 0}, {"word": "that", "trailer": " ", "id": 0}, {"word": "came", "trailer": " ", "id": 0}, {"word": "to", "trailer": " ", "id": 0}, {"word": "Joel", "trailer": ", ", "id": 0}, {"word": "the", "trailer": " ", "id": 0}, {"word": "son", "trailer": " ", "id": 0}, {"word": "of", "trailer": " ", "id": 0}, {"word": "Pethuel", "trailer": ". ", "id": 0}], "notes": [], "section": "Joel 1:1"}, "2": {"text": "Hear this, you elders,", "raw_text": "Hear this, you elders,", "words": [{"word": "Hear", "trailer": " ", "id": 0}, {"word": "this", "trailer": ", ", "id": 0}, {"word": "you", "trailer": " ", "id": 0}, {"word": "elders", "trailer": ", ", "id": 0}], "notes": [], "section": "Joel 1:2"}, "3": {"text": "Tell your children about it,", "raw_text": "Tell your children about it,", "words": [{"word": "Tell", "trailer": " ", "id": 0}, {"word": "your", "trailer": " ", "id": 0}, {"word": "children", "trailer": " ", "id": 0}, {"word": "about", "trailer": " ", "id": 0}, {"word": "it", "trailer": ", ", "id": 0}], "notes": [], "section": "Joel 1:3"}, "4": {"text": "What the swarming locust has left, the great locust has eaten.", "raw_text": "What the swarming locust has left, the great locust has eaten.", "words": [{"word": "What", "trailer": " ", "id": 0}, {"word": "the", "trailer": " ", "id": 0}, {"word": "swarming", "trailer": " ", "id": 0}, {"word": "locust", "trailer": " ", "id": 0}, {"word": "has", "trailer": " ", "id": 0}, {"word": "left", "trailer": ", ", "id": 0}, {"word": "the", "trailer": " ", "id": 0}, {"word": "great", "trailer": " ", "id": 0}, {"word": "locust", "trailer": " ", "id": 0}, {"word": "has", "trailer