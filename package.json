{
	"name": "polyglot-bible-reader",
	"private": true,
	"version": "0.1.14",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "node scripts/download_data.js",
		"build": "ADAPTER=node vite build",
		"build:www": "ADAPTER=static vite build",
		"build:static": "npm run build:www",
		"build:gh": "ADAPTER=github vite build",
		"build:github": "npm run build:gh",
		"preview": "vite preview",
		"preview:www": "ADAPTER=static vite preview",
		"preview:gh": "ADAPTER=github vite preview",
		"preview:github": "npm run preview:gh",
		"deploy": "npm run deploy:www",
		"deploy:www:node": "./scripts/deploy_www_node.sh",
		"deploy:www": "./scripts/deploy_www.sh",
		"deploy:www:quick": "./scripts/deploy_www.sh --no-build",
		"deploy:www:promote": "./scripts/deploy_www.sh --promote",
		"deploy:promote": "npm run deploy:www:promote",
		"deploy:www:history": "./scripts/deploy_www.sh --history",
		"deploy:history": "npm run deploy:www:history",
		"deploy:www:clean": "./scripts/deploy_www.sh --clean",
		"rollback:www": "./scripts/deploy_www.sh --rollback",
		"rollback": "npm run rollback:www",
		"deploy:vps": "npm run deploy:www",
		"deploy:vps:quick": "npm run deploy:www:quick",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.0",
		"showdown": "^2.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"chart.js": "^4.5.1",
		"gridjs": "^6.2.0",
		"gridjs-svelte": "^2.1.1",
		"sql.js-httpvfs": "^0.8.12",
		"svelte-chartjs": "^4.0.1"
	}
}
